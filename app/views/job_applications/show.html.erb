<div class="container">
  <div class="d-flex justify-content-end ps-5 position-relative" style="z-index: 10;">
    <%= link_to 'New Job Application', new_job_application_path, class: "btn btn-primary btn-sm" %>
  </div>
  <div class="row align-items-center justify-content-center">
    <div class="col-md-1 text-center">
      <% if @prev_job_app %>
        <%= link_to job_application_path(@prev_job_app) do %>
          <i class="fa-solid fa-chevron-left fa-3x" style="color: blue;"></i>
        <% end %>
      <% end %>
    </div>
    <div class="col-md-10">
      <%= link_to job_application_touchpoints_path(@job_application.id), class: "text-decoration-none text-dark d-block" do %>
        <div class="card mx-auto my-5" style="min-height: 24rem; max-width: 48rem;" >
          <div class="card-header d-flex justify-content-between flex-wrap align-items-center px-5">
            <div class="fs-5"> <%= @job_application.company_name %> </div>
            <div> Application Due On: <%= @job_application.due_date.strftime("%b %d") %> </div>
          </div>
          <div class="card-body">
            <h5 class="card-title d-flex justify-content-center position-relative mb-4 pt-3">
              <span class="mx-auto text-uppercase fs-3"> <%= @job_application.job_title %> </span>
              <span class="badge rounded-pill text-bg-info position-absolute end-0"> <%= @job_application.status %> </span>
            </h5>
            <div class="card-text text-center mt-1 py-3">
              <div class="container">
                <div class="row justify-content-center">
                  <div class="col-10">
                    <span class="mx-auto"> <%= @job_application.job_description %></span>
                  </div>
                </div>
                <div class="row justify-content-between pt-5">
                  <div class="col-6">
                    <%= link_to( "Edit Application Details", edit_job_application_path(@job_application.id), class: "btn btn-secondary" )%>
                  </div>
                  <div class="col-6">
                    <%= link_to( "Add New Touchpoint", new_job_application_touchpoint_path(@job_application.id), class: "btn btn-primary" )%>
                  </div>

                </div>
              </div>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="col-md-1 text-center">
      <% if @next_job_app %>
        <%= link_to job_application_path(@next_job_app) do %>
          <i class="fa-solid fa-chevron-right fa-3x" style="color: blue;"></i>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
