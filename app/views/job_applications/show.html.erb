<div class="container py-3">

  <% @recommendations.each do |rec| %>
    <div class="alert alert-info">
      <%= rec.message %>
    </div>
  <% end %>

  <div class="row align-items-center justify-content-center">
    <div class="col-md-1 text-center">
      <% if @prev_job_app %>
        <%= link_to job_application_path(@prev_job_app), class: "btn btn-outline-primary" do %>
          <i class="fa-solid fa-chevron-left fa-3x"></i>
        <% end %>
      <% end %>
    </div>
    <div class="d-flex justify-content-center mt-3">
      <%= link_to 'New Job Application', new_job_application_path, class: "btn btn-primary btn-sm" %>
    </div>
    <div class="col-md-10">
      <%= link_to job_application_touchpoints_path(@job_application.id), class: "text-decoration-none text-dark d-block" do %>
        <div class="card mx-auto my-3" style="min-height: 24rem; max-width: 48rem;" >
          <div class="card-header d-flex justify-content-between flex-md-rown align-items-md-center gap-2">
            <div class="fw-semibold fs-5"> <%= @job_application.company_name %> </div>
            <span class="badge rounded-pill text-bg-info"> <%= @job_application.status %> </span>
            <div class="small text-muted"> Due: <%= @job_application.due_date.strftime("%b %d") %> </div>
          </div>
          <div class="card-body">
            <div class="position-relative mb-4 text-center">
              <h5 class="text-uppercase fw-bold fs-4 m-0"> <%= @job_application.job_title %> </h5>

            </div>

            <p class="text-center px-md-5"> <%= @job_application.job_description %></p>

            <div class="row mt-4 g-2">
              <div class="col-12 col-md-6">
                <%= link_to( "Edit Application Details", edit_job_application_path(@job_application.id), class: "btn btn-secondary w-100" )%>
              </div>
              <div class="col-12 col-md-6">
                <%= link_to( "Add New Touchpoint", new_job_application_touchpoint_path(@job_application.id), class: "btn btn-primary w-100" )%>
              </div>

            </div>
          </div>

        </div>
      <% end %>

      <div class="col-md-1 text-center">
        <% if @next_job_app %>
          <%= link_to job_application_path(@next_job_app), class: "btn btn-outline-primary" do %>
            <i class="fa-solid fa-chevron-right fa-3x"></i>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>
