<div class="container py-3">

  <% if @recommendations.any? %>
    <%= render "shared/toasts", 
          message: "You have #{ link_to("recommended actions", system_recommendations_path)} for this job application.".html_safe,
          css_class: "text-info-emphasis" %>
  <% end %>

  <div class="row align-items-center justify-content-center g-0">
    <div class="col-12 col-md-auto text-center">
      <% if @prev_job_app %>
        <%= link_to job_application_path(@prev_job_app), class: "btn btn-outline-primary" do %>
          <i class="fa-solid fa-chevron-left fa-3x"></i>
        <% end %>
      <% end %>
    </div>

    <div class="col-12 col-md-auto">
      <div class="card mx-md-3 my-3" 
            style="min-height: 24rem; max-width: 48rem; cursor: pointer;"
            onclick="window.location='<%= job_application_touchpoints_path(@job_application) %>'"
            data-bs-toggle="tooltip"
            data-bs-placement="top"
            title="View Touchpoints">
        <div class="card-header d-flex justify-content-between flex-md-row align-items-md-center gap-2">

          <div class="small text-muted me-md-1"> Due: <%= @job_application.due_date.strftime("%b %d") %> </div>
          <div class="fw-semibold fs-4"> <%= @job_application.company_name %> </div>
          <span class="badge rounded-pill <%= status_badge_class(@job_application.status) %>"> <%= @job_application.status %> </span>
        </div>
        <div class="card-body d-flex flex-column">
          <div class="position-relative text-center">
            <h5 class="text-uppercase fw-bold fs-4 mt-2"> <%= @job_application.job_title %> </h5>
          </div>
          <u class="mt-auto fs-6" style="color: #000000;">Job Description:</u><br>
          <p class="text-start px-md-2" style="color: #000000;"> <%= @job_application.job_description %></p>

          <div class="row mt-4 g-2 mt-auto align-items-center">
            <div class="col-6 text-start">
              <%= link_to "Edit Application Details", 
                    edit_job_application_path(@job_application.id),
                    class: "btn btn-outline-primary-border ms-md-3" %>
            </div>
            <div class="col-6 text-end">
              <%= link_to "Add New Touchpoint", 
                    new_job_application_touchpoint_path(@job_application.id), 
                    class: "btn btn-primary me-md-4" %>
            </div>
          </div>
        </div>

      </div>
    </div>

    <div class="col-12 col-md-auto text-center">
      <% if @next_job_app %>
        <%= link_to job_application_path(@next_job_app), class: "btn btn-outline-primary" do %>
          <i class="fa-solid fa-chevron-right fa-3x"></i>
        <% end %>
      <% end %>
    </div>
  </div>
</div>
