<div class="container">


    <div class="d-flex justify-content-between align-items-center">
    <h3 class="col-6 col-md-8 offset-md-2"> Job Applications </h3>
    <div class="col-6 col-md-1 ps-2 position-relative" style="z-index: 10;">
      <%= link_to new_job_application_path, 
            class: "btn btn-primary btn-sm", 
            data: { bs_toggle: "tooltip" }, 
            title: "New Application" do %>
        <i class="fa fa-plus-circle"></i>
      <% end %>
    </div>
    </div>

  <div class="col-12 col-md-8 offset-md-2">
    <% @job_applications.each do |job_app| %>
    <%= link_to job_application_path(job_app.id), 
            class: "text-decoration-none text-dark d-block", 
            data: { bs_toggle: "tooltip" }, 
            title: "Click for details" do %>
      <div class="card shadow-sm mb-5 border-0">
        <div class="card-body">

          <!-- Top Row -->
          <div class="d-flex justify-content-between align-items-start">

            <div>
              <h5 class="mb-1 fw-semibold">
                <%= job_app.job_title %>
              </h5>
              <h6 class="fst-italic">
                <%= job_app.company_name %>
              </h6>

              <small class="text-muted">
                application due: <%= job_app.due_date.strftime("%b %d, %Y") %>
              </small>
            </div>

          </div>

          <!-- Status Badge -->
          <div class="mt-2">
            <span class="badge px-3 py-2 <%= status_badge_class(job_app.status) %>">
              <%= job_app.status %>
            </span>
          </div>

          <!-- Actions -->
          <div class="d-flex justify-content-start gap-3 mt-3">
            <%= link_to edit_job_application_path(job_app.id), 
                  class: "text-dark", 
                  data: { bs_toggle: "tooltip" }, 
                  title: "Edit Application" do %>
              <i class="fa fa-pencil"></i>
            <% end %>

            <%= link_to job_application_path(job_app.id), 
                  class: "text-muted", 
                  method: :delete,
                  data: { bs_toggle: "tooltip", 
                          confirm: "Are you sure?" },
                  title: "Delete Application" do %>
              <i class="fa fa-trash"></i>
            <% end %>
          </div>

        </div>
      </div>

    <% end %>
    <% end %>
  </div>
</div>
