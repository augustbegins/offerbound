<div class="container">
  <div class="d-flex justify-content-end ps-5 position-relative" style="z-index: 10;">
    <%= link_to 'New Job Application', new_job_application_path, class: "btn btn-primary btn-sm" %>
  </div>
  </div>
  <div class="">
    <div class="row">
      <h3 class="col-md-8 offset-md-1"> Job Applications </h3>
      <hr class="mt-1 mb-3 offset-md-1" style="width: 80%;">
    </div>
    <% @job_applications.each do |job_app| %>
      <%= link_to job_application_path(job_app.id), class: "text-decoration-none text-dark d-block" do %>
        <div class="d-flex justify-content-end ms-5 my-1">
          <div class="col-1 d-flex align-items-center text-end justify-content-end p-1">
            <small><%= job_app.created_at.strftime("%b %d") %></small>
          </div>

          <div class="col-1 d-flex align-items-center justify-content-center">
            <i class="fa-solid fa-chevron-right"></i>
          </div>
          <div class="col-2 d-flex align-items-center justify-content-start">
            <h6 class="p-2"> <span class="badge text-bg-info px-3 py-2"><%= job_app.status %> </span></h6>
          </div>
          <div class="col-8 d-flex align-items-center mb-1">
              <div class="card">
                <div class="card-body">
                  <div class="fs-6 justify-content-start">
                    <%= job_app.job_title %>
                  </div>
                </div>
              </div>

            </div>
          </div>
        <% end %>
      <% end %>
    </div>
</div>
