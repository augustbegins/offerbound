<div class="container my-4">

  <div class="row justify-content-between align-items-center offset-md-1">

    <div class="col-1 col-md-auto">
      <% if @prev_job_app %>
        <%= link_to job_application_touchpoints_path(@prev_job_app), 
          class: "btn btn-outline-primary btn-sm" do %>
          <i class="fa-solid fa-chevron-left fa-lg"></i>
        <% end %>
      <% end %>
    </div>

    <div class="col-10 col-md-10">
      <%= link_to job_application_path(@job_application), 
            class: "text-decoration-none text-dark", 
            data: { bs_toggle: "tooltip" }, 
            title: "Back to Job App Details" do %>
        <div class="card shadow-sm h-100">
          <div class="card-body ">
            <div>
              <span class="fw-semibold mb-1 text-center fs-5">
                <%= @job_application.job_title.upcase_first %>
              </span>
              <span class="text-muted mb-1 text-center">
                at <%= @job_application.company_name%>
              </span>
            </div>
            <div>
              <small class="text-start text-decoration-underline">
                Job Description:
              </small>
            </div>
            <div>
              <p class="mb-0 small line-clamp-4 text-start fw-semibold">
                <%= @job_application.job_description %>
              </p>
            </div>
          </div>
        </div>
      <% end %>
    </div>
    <div class="col-1 col-md-auto">
      <% if @next_job_app %>
        <%= link_to job_application_touchpoints_path(@next_job_app), class: "btn btn-outline-primary btn-sm" do %>
          <i class="fa-solid fa-chevron-right fa-lg"></i>
        <% end %>
      <% end %>
    </div>
  </div>
</div>

<div class="container offset-md-.5 mt-5">
  <div class="row mb-3 offset-md-3">
    <div class="col-12 col-md-8">
      <div class="d-flex align-items-baseline justify-content-center">
        <h4 class="fw-semibold">
          Timeline
        </h4>
        <div class="text-center">
          <%= link_to new_job_application_touchpoint_path(@job_application.id), 
                class: "btn btn-outline-primary btn-lg", 
                data: { bs_toggle: "tooltip" }, 
                title: "New Touchpoint" do %>
            <i class="fa fa-plus-circle"></i>
          <% end %>
        </div>
      </div>
      <hr>
    </div>
  </div>

  <% @job_application.touchpoints.order( :occurred_at ).each do |touchpoint| %>
    <%= link_to touchpoint_path(touchpoint),
        class: "text-decoration-none text-dark d-block", 
        data: { bs_toggle: "tooltip" }, 
        title: "Click for details" do %>
      <div class="row justify-content-center mb-3">
        <div class="col-12 col-md-6">
          <div class="card shadow-sm border-0">
            <div class="card-body">
              <div class="d-flex align-items-center justify-content-between">
                <small class="text-muted">
                  <%= touchpoint.occurred_at.strftime("%b %d") %>
                </small>
                <span class="badge <%= category_badge_class(touchpoint.category) %>">
                  <%= touchpoint.category %>
                </span>
              </div>
              <div class="mt-3">
                <%= link_to touchpoint_path(touchpoint.id), class: "text-decoration-none text-dark d-block" do %>
                  <div class="fw-medium text-center" style="color: #09637E;">
                    <%= touchpoint.short_description %>
                  </div>
                <% end %>
              </div>

              <div class="d-flex justify-content-end gap-3 mt-3">
                <%= link_to edit_touchpoint_path(touchpoint.id), 
                  class: "btn btn-sm btn-outline-primary d-flex align-items-center justify-content-center", 
                  style: "width: 20px; height: 20px;", 
                  data: { bs_toggle: "tooltip" }, 
                  title: "Edit Touchpoint" do %>
                  <i class="fa fa-pencil"></i>
                <% end %>

                <%= link_to touchpoint_path(touchpoint.id),
                    class: "btn btn-sm btn-outline-danger border-0 d-flex align-items-center justify-content-center", 
                    style: "width: 20px; height: 20px;",
                    method: :delete,
                    data: { bs_toggle: "tooltip", 
                            confirm: "Are you sure?" },
                    title: "Delete Touchpoint" do %>
                  <i class="fa fa-trash"></i>
                <% end %>
              </div>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% end %>

</div>
</div>
