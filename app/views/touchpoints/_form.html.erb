
<% @job_application.errors.full_messages.each do |message| %>
  <p style="color: red;"><%= message %> </p>
<% end %>

<div class="container">
  <div class="row justify-content-center mt-3">
    <div class="col-md-3">
      <%= form_with(model: form_object) do |form| %>
        <div class="mb-3">
          <%= form.label :occurred_at, class: "form-label" %>
          <%= form.date_field :occurred_at, class: "form-control" %>
        </div>
        <div class="row justify-content-start">
          <div class="col-md-8 mb-3">
            <%= form.label :category, class: "form-label"%>
            <%= form.select :category, Touchpoint.categories.keys, class: "form-select form-select-lg" %>
          </div>
        </div>
        <div class="mb-3">
          <%= form.label :short_description, class: "form-label" %>
          <%= form.textarea :short_description, class: "form-control" %>
        </div>
        <div class="mb-3">
          <%= form.label :notes, class: "form-label" %>
          <%= form.textarea :notes, class: "form-control" %>
        </div>
        
        <div class=" row justify-content-end justify-content-md-evenly mt-4">
          <div class="col-2 col-md-2 offset-md-1">
            <%= link_to job_application_touchpoints_path(@job_application.id), 
                  class: "btn btn-lg btn-outline-secondary  d-flex align-items-center justify-content-center",
                  style: "width: 30px; height: 30px;", 
                  data: { bs_toggle: "tooltip" },
                  title: "Cancel" do %>
              <i class="fa fa-undo"></i>
            <% end %>
          </div>
          <div class="col-2 col-md-2">
            <%= form.button :submit,
                class: "btn btn-lg btn-primary d-flex align-items-center justify-content-center",
                style: "width: 30px; height: 30px;", 
                data: { bs_toggle: "tooltip" },
                title: "Save" do %>
              <i class="fa fa-check"></i>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
