<div class="container pt-5 mt-5">

  <div class="row align-items-center justify-content-center">
    <div class="col-md-1 text-center">
      <% if @prev_touchpoint %>
        <%= link_to touchpoint_path(@prev_touchpoint) do %>
          <i class="fa-solid fa-chevron-left fa-3x" style="color: blue;"></i>
        <% end %>
      <% end %>
    </div>

    <div class="col-md-10">
      <%= link_to job_application_touchpoints_path(@job_application.id), class: "text-decoration-none text-dark d-block" do %>
        <div class="card mx-auto" style="min-height: 24rem; max-width: 48rem;">
          <div class="card-header d-flex justify-content-between flex-wrap align-items-center">
            <div class="offset-md-2 fs-4">
              <%= @job_application.job_title.upcase_first %> at <%= @job_application.company_name %>
            </div>
          </div>

          <div class="card-body text-center fs-4">
            <div class="text-info-emphasis">
              <%= @touchpoint.short_description %>
            </div>
            <div class="card-subtitle text-body-secondary fs-5 pt-5 col-6">
              <%= @touchpoint.category.humanize.titleize %> Notes: 
            </div>
            <p class="pt-3"><%= @touchpoint.notes %></p>
            <div class="text-end pt-5">
              <%= link_to( "Edit Touchpoint Details", edit_touchpoint_path(@touchpoint.id), class: "btn btn-secondary" )%>
            </div>
          </div>
        </div>
      <% end %>
    </div>

    <div class="col-md-1 text-center">
      <% if @next_touchpoint %>
        <%= link_to touchpoint_path(@next_touchpoint) do %>
          <i class="fa-solid fa-chevron-right fa-3x" style="color: blue;"></i>
        <% end %>
      <% end %>
    </div>

  </div>
</div>
