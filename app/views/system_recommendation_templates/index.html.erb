<h1>
  List of all system recommendations
</h1>

<hr>

<article>
  <header>
    <h2>
      Add a new system recommendation
    </h2>
  </header>

  <form action="/insert_system_recommendation" method="post">
    <div>
      <label for="job_application_id_box">
        Job application
      </label>

      <input type="text" id="job_application_id_box" name="query_job_application_id">
    </div>

    <div>
      <label for="recommendation_type_box">
        Recommendation type
      </label>

      <input type="text" id="recommendation_type_box" name="query_recommendation_type">
    </div>

    <div>
      <label for="message_box">
        Message
      </label>

      <input type="text" id="message_box" name="query_message">
    </div>

    <div>
      <label for="status_box">
        Status
      </label>

      <input type="text" id="status_box" name="query_status">
    </div>

    <button type="submit">
      Create system recommendation
    </button>
  </form>
</article>

<hr>

<article>
  <ul>
    <% @list_of_system_recommendations.each do |a_system_recommendation| %>
      <li>
        <a href="/system_recommendations/<%= a_system_recommendation.id %>">
          System recommendation #<%= a_system_recommendation.id %>
        </a>
      </li>
    <% end %>
  </ul>
</article>

<hr>
