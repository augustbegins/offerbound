<% if user_signed_in? %>
  <div class="container mb-1">
    <nav aria-label="breadcrumb" class="">
      <ol class="breadcrumb container">

        <% if controller_name == "job_applications" %>
          <li class="breadcrumb-item">
            <%= link_to "Job Applications", job_applications_path  %>
          </li>
          <% if controller_name == "job_applications" && action_name == "new" %>
            <li class="breadcrumb-item active" aria-current="page">
              New Job Application
            </li>
          <% elsif @job_application %>
            <li class="breadcrumb-item active" aria-current="page">
              <%= @job_application.job_title %> || <%= @job_application.company_name %>
            </li>
          <% end %>
        <% end %>

        <% if controller_name == "touchpoints" %>
          <li class="breadcrumb-item">
            <%= link_to "Touchpoints", job_application_touchpoints_path(@job_application) %>
          </li>
          <% if controller_name == "touchpoints" && action_name == "new" %>
            <li class="breadcrumb-item active" aria-current="page">
              New Touchpoint
            </li>
          <% elsif @touchpoint %>
            <li class="breadcrumb-item active" aria-current="page">
              <%= @touchpoint.category.titleize %> on <%= @touchpoint.occurred_at.strftime("%m/%d/%y") %>
            </li>
          <% end %>
        <% end %>

        <% if controller_name == "system_recommendations" %>
          <li class="breadcrumb-item">
            <%= link_to "Next Steps", system_recommendations_path %>
          </li>
          <% if controller_name == "system_recommendations" && action_name != "index" %>
            <li class="breadcrumb-item active" aria-current="page">
              <%= action_name.titleize %>
            </li>
          <% end %>
        <% end %>
      </ol>
    </nav>
  </div>
  <% end %>
