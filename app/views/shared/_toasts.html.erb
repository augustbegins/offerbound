<div class="position-fixed top-0 end-0 p-2 me-2 mt-5 p-md-3 mt-md-5 me-md-5" 
      style="z-index: 1100">

  <div id="myToast" 
        class="toast fade <%= local_assigns[:css_class] %>" 
        role="alert" 
        aria-live="assertive" 
        aria-atomic="true"
        data-bs-autohide="true"
        data-bs-delay="5000">

    <div class="d-flex justify-content-between align-items-center">
      <div class="toast-body pe-3">
        <%= message %>
      </div>
      <div>
        <button type="button" 
                  class="btn-close me-2 ms-2 mt-md-1" 
                  data-bs-dismiss="toast" 
                  aria-label="Close"></button>
      </div>
    </div>

  </div>
</div>
